<%- include("partials/header") %>

<style>
  :root {
    --primary-color: #6366f1;
    --secondary-color: #a855f7;
    --text-main: #1f2937;
    --text-muted: #6b7280;
    --glass-bg: rgba(255, 255, 255, 0.85);
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Inter', sans-serif;
    /* Animated Gradient Background */
    background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
    background-size: 400% 400%;
    animation: gradientBG 15s ease infinite;
    overflow: hidden;
  }

  @keyframes gradientBG {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .login-container {
    position: relative;
    width: 100%;
    max-width: 420px;
    padding: 20px;
    z-index: 1;
  }

  .login-card {
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 28px;
    padding: 50px 40px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    text-align: center;
    transition: transform 0.3s ease;
  }

  .login-card:hover {
    transform: translateY(-5px);
  }

  .login-card h2 {
    font-size: 32px;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 10px 0;
    letter-spacing: -1px;
  }

  .login-card p {
    color: var(--text-muted);
    font-size: 15px;
    margin-bottom: 35px;
  }

  /* Modern Floating Inputs */
  .input-group {
    position: relative;
    margin-bottom: 25px;
    text-align: left;
  }

  .input-group input {
    width: 100%;
    padding: 15px 18px;
    background: rgba(243, 244, 246, 0.6);
    border: 2px solid transparent;
    border-radius: 14px;
    font-size: 15px;
    color: var(--text-main);
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .input-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 13px;
    color: var(--text-main);
    margin-left: 5px;
  }

  .input-group input:focus {
    outline: none;
    background: #fff;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
  }

  .login-btn {
    width: 100%;
    padding: 16px;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);
    margin-top: 10px;
  }

  .login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.4);
    filter: brightness(1.1);
  }

  .login-btn:active {
    transform: translateY(0);
  }

  .footer-text {
    margin-top: 30px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .footer-text a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 700;
    transition: 0.3s;
  }

  .footer-text a:hover {
    color: var(--secondary-color);
  }

  .orb {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
  }

  .orb-1 { background: #6366f1; top: -50px; left: -50px; }
  .orb-2 { background: #a855f7; bottom: -50px; right: -50px; }

</style>

<div class="login-container">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <div class="login-card">
    <h2>Welcome Back</h2>
    <p>Sign in to your dashboard</p>

    <form action="/login" method="POST">
      <div class="input-group">
        <label>Username</label>
        <input type="text" name="username" placeholder="e.g. rahul_admin" required>
      </div>

      <div class="input-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required>
      </div>

      <button type="submit" class="login-btn">Sign In to Account</button>
    </form>

    <div class="footer-text">
      Don't have an account? <a href="/register">Create Account</a>
    </div>
  </div>
</div>

</body>
</html>